# ===== 基本 =====
# 開発: sqlite:///./newsbot.db / 本番(Supabase): postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./newsbot.db
ARTISTS_CONFIG=config/artists.yaml
LOG_LEVEL=INFO
# JSON Lines 形式のログファイル（空なら標準出力のみ）
LOG_FILE=logs/newsbot.jsonl

# ===== AI =====
# anthropic | fake（fake は API キー不要の動作確認用。判定は固定値）
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=60

# 閾値（0〜100）。下回ると通知しない
MIN_RELEVANCE_SCORE=70
MIN_IMPORTANCE_SCORE=50
MIN_RELIABILITY_SCORE=60
# 公開からこの時間を超えた記事は AI に回さず却下
MAX_ARTICLE_AGE_HOURS=72

# ===== ntfy =====
NTFY_SERVER=https://ntfy.sh
# 推測不可能な長いランダム文字列にする（例: python -c "import secrets;print('newsbot-'+secrets.token_urlsafe(24))"）
NTFY_TOPIC=
# アクセス制御付きトピック/セルフホスト時のアクセストークン（任意だが推奨）
NTFY_TOKEN=

# ===== 承認 API =====
# iPhone から到達できる HTTPS の公開 URL（末尾スラッシュなし）
PUBLIC_BASE_URL=https://newsbot.example.com
# 承認トークンの有効期限（時間）
ACTION_TOKEN_TTL_HOURS=48

# ===== X API (OAuth 1.0a User Context) =====
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# true の間は X へ送信せずダミー ID を返す
X_DRY_RUN=true

# ===== 定期実行 =====
ENABLE_SCHEDULER=false
COLLECT_INTERVAL_MINUTES=10
